# ========================================================
#  Learnlytics - MySQL Database Configuration
# ========================================================
# Copy this file to .env and fill in your actual credentials.
# The application checks both MYSQL_* and DB_* variable names.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_actual_mysql_password_here
MYSQL_DATABASE=elearning_db

# Optional Flask session secret
SECRET_KEY=learnlytics_secret_key_change_in_production
